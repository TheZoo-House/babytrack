#!/usr/bin/env python3
"""Check the native large-history dropdown benchmark in an XCTest result."""
import json
import math
import statistics
import subprocess
import sys

if len(sys.argv) not in (2, 3) or len(sys.argv) == 3 and sys.argv[2] != "--relative":
    sys.exit("Usage: scripts/check-ios-dropdown-performance <result.xcresult> [--relative]")

def cpu_measurements(test_name):
    results = json.loads(subprocess.check_output([
        "xcrun", "xcresulttool", "get", "test-results", "metrics", "--path", sys.argv[1],
        "--test-id", f"BabytrackUITests/{test_name}()",
    ]))
    values = [value for test in results for run in test["testRuns"]
              for metric in run["metrics"]
              if metric["identifier"] == "com.apple.dt.XCTMetric_CPU-house.thezoo.babytrack.time"
              for value in metric["measurements"]]
    if not values or any(not math.isfinite(value) or value <= 0 for value in values):
        sys.exit("Dropdown CPU measurements missing or invalid")
    return values

large = cpu_measurements("testLargeHistoryDropdownPerformance")
average = statistics.mean(large)
if len(sys.argv) == 3:
    # Same visible rows and actions on this runner; isolate work caused by history size.
    # A slow/noisy control must not inflate the allowed large-history budget.
    controls = cpu_measurements("testSmallHistoryDropdownPerformance")
    variation = statistics.pstdev(controls) / statistics.mean(controls)
    # XCTest's 10% relative-deviation criterion makes the control a usable calibration.
    if variation > 0.10:
        print(f"INCONCLUSIVE: control CPU variation {variation * 100:.1f}% exceeds 10%; recalibrate")
        sys.exit(2)
    control = min(controls)
    ratio = average / control
    print(f"Dropdown CPU: {average * 1000:.1f} ms large / {control * 1000:.1f} ms fastest control; ratio {ratio:.2f}; limit 1.50")
    if ratio >= 1.5:
        sys.exit("FAIL: large care history adds excessive UI work")
else:
    worst = max(large)
    print(f"Dropdown open/close CPU: {average * 1000:.1f} ms mean, {worst * 1000:.1f} ms worst; limit 500 ms")
    if worst >= 0.5:
        sys.exit("FAIL: care history exceeds the local CPU budget")
print("PASS")
