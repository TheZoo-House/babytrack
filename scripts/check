#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."
if [[ "${1:-}" != --core ]]; then
  node --test server/*.test.mjs relay/*.test.mjs
  python3 scripts/check-contracts.py
  python3 scripts/test-dropdown-performance.py
fi
if [[ "${1:-}" != --server ]]; then swift test --package-path app/BabyCore; fi
git diff --check
